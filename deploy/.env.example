TUESDAY_OWNER_NAME=Alex
TUESDAY_API_TOKEN=change-me-long-random      # chat page and wire-pod send this as the Bearer token / API key
TUESDAY_MINDS=monday,tuesday,wednesday,thursday,friday,saturday,sunday   # fewer = less memory; Tuesday is required
OLLAMA_MAX_LOADED_MODELS=2
TUESDAY_TZ=Europe/London
TUESDAY_ROBOT=remote                         # robot commands go through a relay (your Mac, when it's home)
BODY_TOKEN=change-me-another-long-random     # shared with the relay
OLLAMA_KEEP_ALIVE=5m                         # Oracle Always Free (not upgraded): set -1
TUESDAY_SPEAK_VIA_RELAY=1                    # answers spoken in Tuesday's own voice when the Mac relay is connected
