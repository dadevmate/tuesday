# Tuesday settings (copy to tuesday/.env)
# Who Tuesday works for (personal details live only here, never in the code)
TUESDAY_OWNER_NAME=Alex
# How Tuesday addresses you, "|"-separated
TUESDAY_ADDRESS=Sir|Alex
# Your company or main project (optional): high-stakes questions about it get deeper research
# TUESDAY_COMPANY=Acme
# The face name you enrolled on the robot ("Hey Vector, my name is …"), comma-separated spellings
# TUESDAY_OWNER_FACE=Alex
TUESDAY_CITY=London
# The seven minds (open-weight, served by Ollama on your own hardware). Fewer = less memory; Tuesday is required.
TUESDAY_MINDS=monday,tuesday,wednesday,thursday,friday,saturday,sunday
# Private memories (feelings, secrets) may inform the council's answers to you; 0 keeps them with Tuesday alone
TUESDAY_PRIVATE_IN_COUNCIL=1
# Tuesday Core: Tuesday, Monday, Wednesday, Thursday and Saturday share one Qwen3 8B in memory (llama.cpp). 0 = Ollama only
TUESDAY_CORE=1
# Speculative decoding with Qwen3 0.6B (1 = on; off by default: the minds' adapters made its guesses miss)
TUESDAY_CORE_DRAFT=0
# Robot: mock until the Vector arrives, then vector
TUESDAY_ROBOT=mock
# VECTOR_SERIAL=00e20100
# VECTOR_NAME=Vector-A1B2
# VECTOR_IP=192.168.1.50
TUESDAY_VISION_MODEL=qwen3-vl:4b-instruct
TUESDAY_TZ=Europe/London
TUESDAY_VOICE_VOLUME=75
# TUESDAY_MOCK_SPEAK=1   # before the robot arrives: play Tuesday's voice on the Mac's speakers
# Every reply is one sentence, like on the robot (start a message with /long for a full answer)
TUESDAY_ONE_SENTENCE=1
# Answers to "Hey Tuesday" are spoken in Tuesday's own voice (needs the robot connected through the SDK)
TUESDAY_SPEAK_VIA_RELAY=1
# Email (./run.sh --email-setup fills this in; the app password is kept in the macOS Keychain)
# TUESDAY_EMAIL_ADDRESS=you@gmail.com
# TUESDAY_IMAP_HOST=imap.gmail.com
# TUESDAY_SMTP_HOST=smtp.gmail.com
# Private search (./run.sh --install-search)
# TUESDAY_SEARXNG_URL=http://127.0.0.1:8888
# Background jobs stop after this many minutes
# TUESDAY_JOB_MINUTES=45
# Tuesday's own voice (Piper, offline): a female Irish voice. Speakers p266 p283 p288 p293 p295 p313 p340 p351 are Irish women;
# preview one with: .venv/bin/python -m tuesday say "Evening, Sir." en_GB-vctk-medium p288
TUESDAY_VOICE=en_GB-vctk-medium
TUESDAY_VOICE_SPEAKER=p288
